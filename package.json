{
  "name": "it-toolbox",
  "version": "1.6.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2024-11-01 --port 8788",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p functions/tsconfig.json --noEmit",
    "lint": "eslint src packages functions --ext .ts,.tsx",
    "lint:fix": "eslint src packages functions --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "audit:meta": "node scripts/audit-meta.mjs",
    "smoke": "node scripts/smoke.mjs",
    "icons:gen": "node scripts/generate-icon-map.mjs",
    "icons:check": "node scripts/generate-icon-map.mjs --check",
    "report:bundle": "node scripts/report-bundle.mjs",
    "check": "pnpm typecheck && pnpm typecheck:api && pnpm lint && pnpm test && pnpm audit:meta --check && pnpm icons:check && node scripts/check-store-selectors.mjs",
    "deploy": "pnpm check && vite build && wrangler pages deploy dist --project-name=it-toolbox"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "@peculiar/x509": "^1.12.3",
    "@tanstack/react-router": "^1.58.0",
    "bcryptjs": "^2.4.3",
    "browser-image-compression": "^2.0.2",
    "chroma-js": "^2.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.0",
    "colorthief": "^2.4.0",
    "cron-parser": "^4.9.0",
    "cronstrue": "^2.50.0",
    "dayjs": "^1.11.0",
    "diff": "^7.0.0",
    "exifr": "^7.1.3",
    "fuse.js": "^7.0.0",
    "highlight.js": "^11.10.0",
    "hono": "^4.6.0",
    "i18next": "^25.10.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^5.9.0",
    "js-yaml": "^4.1.0",
    "jsbarcode": "^3.12.3",
    "jsonpath-plus": "^10.4.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.0.1",
    "marked": "^15.0.0",
    "marked-highlight": "^2.1.0",
    "mathjs": "^15.1.1",
    "nanoid": "^5.0.0",
    "papaparse": "^5.4.1",
    "prettier": "^3.4.2",
    "punycode": "^2.3.1",
    "qrcode": "^1.5.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^16.6.2",
    "semver": "^7.6.3",
    "smol-toml": "^1.3.0",
    "sql-formatter": "^15.0.0",
    "svgo": "^3.3.2",
    "tailwind-merge": "^2.5.0",
    "ua-parser-js": "^1.0.0",
    "ulid": "^2.3.0",
    "zustand": "^5.0.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.0",
    "@types/chroma-js": "^2.4.0",
    "@types/colorthief": "^2.3.0",
    "@types/diff": "^5.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/jszip": "^3.4.0",
    "@types/papaparse": "^5.3.0",
    "@types/punycode": "^2.1.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.5.8",
    "@types/ua-parser-js": "^0.7.0",
    "@types/zxcvbn": "^4.4.4",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.0",
    "dpdm": "^3.15.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "happy-dom": "^15.11.7",
    "postcss": "^8.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.0",
    "wrangler": "^3.0.0"
  }
}
